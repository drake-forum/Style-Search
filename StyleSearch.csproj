<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>AintoWindows.Program</StartupObject>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>StyleSearch</AssemblyName>
    <AssemblyTitle>Style Search</AssemblyTitle>
    <Product>Style Search</Product>
    <RootNamespace>AintoWindows</RootNamespace>
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
    <InformationalVersion>1.0.4</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="logo.png" LogicalName="StyleSearch.logo.png" />
    <EmbeddedResource Include="logo.ico" LogicalName="StyleSearch.logo.ico" />
  </ItemGroup>
</Project>
