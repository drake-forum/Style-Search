<Window x:Class="AintoWindows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Style Search Settings" Width="520" Height="690" MinHeight="600" MaxHeight="820"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="Transparent" Foreground="#FFF3F5F8" FontFamily="Segoe UI" ShowInTaskbar="False"
        PreviewKeyDown="SettingsWindow_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#FFA3ABB7"/>
        <SolidColorBrush x:Key="Card" Color="#7A171D27"/>
        <SolidColorBrush x:Key="Line" Color="#42FFFFFF"/>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFC6CCD5"/>
            <Setter Property="Background" Value="#5020232A"/>
            <Setter Property="BorderBrush" Value="#45FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#803B82D8"/><Setter TargetName="Chip" Property="BorderBrush" Value="#A07CB8F2"/><Setter Property="Foreground" Value="#FFF6F8FB"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="#70323B49"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE1E5EB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                    <Border x:Name="Track" Width="34" Height="19" CornerRadius="10" Background="#55242A34" BorderBrush="#55FFFFFF" BorderThickness="1" Margin="0,0,10,0" DockPanel.Dock="Left">
                        <Ellipse x:Name="Thumb" Width="13" Height="13" Fill="#FFE5E9EF" HorizontalAlignment="Left" Margin="2"/>
                    </Border>
                    <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </DockPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#CE3985E8"/><Setter TargetName="Track" Property="BorderBrush" Value="#C080BDF7"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="IsSnapToTickEnabled" Value="False"/>
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFE9EDF4"/><Setter Property="Background" Value="#50232A35"/>
            <Setter Property="BorderBrush" Value="#45FFFFFF"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#78313B4B"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C0357FE5"/><Setter Property="BorderBrush" Value="#D086BEFF"/><Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="SettingsRoot" ClipToBounds="True">
        <Image x:Name="SettingsBackdrop" Stretch="Fill" IsHitTestVisible="False"/>
        <Border x:Name="SettingsGlassTint" Background="#45101720" IsHitTestVisible="False"/>
        <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
            <Image x:Name="SettingsLogo" Width="34" Height="34" Stretch="Uniform" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Settings" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="Make the launcher feel right for your desktop." Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <Border Background="{StaticResource Card}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
                        <CheckBox x:Name="AcrylicToggle" Content="Liquid glass background" Margin="0,0,0,7"/>
                        <Grid Margin="0,2,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="Backdrop blur amount" FontSize="12" Foreground="#FFDCE1E8" VerticalAlignment="Center"/><Slider x:Name="AcrylicSlider" Grid.Column="1" Minimum="0" Maximum="100"/><TextBlock x:Name="AcrylicValue" Grid.Column="2" Style="{StaticResource ValueText}"/></Grid>
                        <Grid Margin="0,2,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="Glass transparency" FontSize="12" Foreground="#FFDCE1E8" VerticalAlignment="Center"/><Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="20" Maximum="100"/><TextBlock x:Name="OpacityValue" Grid.Column="2" Style="{StaticResource ValueText}"/></Grid>
                        <Grid Margin="0,2,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="Liquid edge highlights" FontSize="12" Foreground="#FFDCE1E8" VerticalAlignment="Center"/><Slider x:Name="GlassIntensitySlider" Grid.Column="1" Minimum="0" Maximum="100"/><TextBlock x:Name="GlassIntensityValue" Grid.Column="2" Style="{StaticResource ValueText}"/></Grid>
                        <Grid Margin="0,2,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="Panel rounding" FontSize="12" Foreground="#FFDCE1E8" VerticalAlignment="Center"/><Slider x:Name="PanelRadiusSlider" Grid.Column="1" Minimum="0" Maximum="36"/><TextBlock x:Name="PanelRadiusValue" Grid.Column="2" Style="{StaticResource ValueText}"/></Grid>
                        <Grid Margin="0,2,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="Result rounding" FontSize="12" Foreground="#FFDCE1E8" VerticalAlignment="Center"/><Slider x:Name="RowRadiusSlider" Grid.Column="1" Minimum="0" Maximum="24"/><TextBlock x:Name="RowRadiusValue" Grid.Column="2" Style="{StaticResource ValueText}"/></Grid>
                        <Grid Margin="0,2,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="Shadow" FontSize="12" Foreground="#FFDCE1E8" VerticalAlignment="Center"/><Slider x:Name="ShadowSlider" Grid.Column="1" Minimum="0" Maximum="100"/><TextBlock x:Name="ShadowValue" Grid.Column="2" Style="{StaticResource ValueText}"/></Grid>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Card}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="LAYOUT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="Search bar width" FontSize="12" Foreground="#FFDCE1E8" VerticalAlignment="Center"/><Slider x:Name="WidthSlider" Grid.Column="1" Minimum="360" Maximum="900"/><TextBlock x:Name="WidthValue" Grid.Column="2" Style="{StaticResource ValueText}"/></Grid>
                        <Grid Margin="0,2,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Launcher shortcut" FontSize="12" Foreground="#FFDCE1E8" VerticalAlignment="Center"/><Button x:Name="ShortcutCaptureButton" Grid.Column="1" Content="Alt + Space" MinWidth="125" Height="32" Click="ShortcutCaptureButton_Click"/></Grid>
                        <TextBlock x:Name="ShortcutStatus" Text="Click the shortcut, then press a key combination." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                        <CheckBox x:Name="FooterToggle" Content="Show keyboard hints and result count"/>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,10"/>
                        <TextBlock Text="SHORTCUTS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,7"/>
                        <TextBlock Text="Shortcut above     Open or hide search" FontSize="12" Foreground="#FFDCE1E8" Margin="0,2"/>
                        <TextBlock Text="↑ / ↓                 Move through results" FontSize="12" Foreground="#FFDCE1E8" Margin="0,2"/>
                        <TextBlock Text="Enter                  Open or paste" FontSize="12" Foreground="#FFDCE1E8" Margin="0,2"/>
                        <TextBlock Text="Esc                     Clear, go back, or hide" FontSize="12" Foreground="#FFDCE1E8" Margin="0,2"/>
                        <TextBlock Text="Ctrl + 1 / 2 / 3   Search, clipboard, snippets" FontSize="12" Foreground="#FFDCE1E8" Margin="0,2"/>
                        <TextBlock Text="Ctrl + ,                 Open settings" FontSize="12" Foreground="#FFDCE1E8" Margin="0,2"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="84" Height="34" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Width="84" Height="34" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
        </Grid>
    </Grid>
</Window>
