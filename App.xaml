<Application x:Class="AintoWindows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#F9FAFC" />
    <SolidColorBrush x:Key="InkBrush" Color="#20232A" />
    <SolidColorBrush x:Key="MutedBrush" Color="#777F8D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6558E8" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,7"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Application.Resources>
</Application>
